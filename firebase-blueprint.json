{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "A campus maintenance ticket reported by students or staff.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique human-readable ticket code e.g. CF-2026-1042",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Short headline of the maintenance issue",
          "maxLength": 150,
          "minLength": 3
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of the issue",
          "maxLength": 2000,
          "minLength": 5
        },
        "building": {
          "type": "string",
          "description": "Campus building name",
          "maxLength": 100
        },
        "roomNumber": {
          "type": "string",
          "description": "Room, lab, or floor designation",
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "description": "Equipment or maintenance category",
          "enum": [
            "electrical",
            "hvac_fan",
            "av_projector",
            "plumbing",
            "internet_wifi",
            "furniture",
            "civil_structural",
            "other"
          ]
        },
        "priority": {
          "type": "string",
          "description": "Assigned urgency level",
          "enum": ["low", "medium", "high", "emergency"]
        },
        "status": {
          "type": "string",
          "description": "Ticket lifecycle stage",
          "enum": ["Reported", "In Progress", "Resolved"]
        },
        "isRuleBasedTriage": {
          "type": "boolean",
          "description": "Flag indicating if triage was generated by fallback rule engine"
        },
        "aiTriageNotes": {
          "type": "string",
          "description": "Reasoning summary for category and priority triage",
          "maxLength": 500
        },
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the student or staff who reported",
          "maxLength": 128
        },
        "authorEmail": {
          "type": "string",
          "description": "Contact email of the reporter",
          "maxLength": 120
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the reporter",
          "maxLength": 100
        },
        "assignedTo": {
          "type": "string",
          "description": "Staff member or maintenance crew assigned",
          "maxLength": 100
        },
        "resolutionNotes": {
          "type": "string",
          "description": "Notes entered upon resolving the ticket",
          "maxLength": 1000
        },
        "estimatedFixHours": {
          "type": "number",
          "description": "Estimated hours to repair"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when ticket was filed"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when ticket was last updated"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "building",
        "roomNumber",
        "category",
        "priority",
        "status",
        "authorId",
        "authorEmail",
        "authorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator or campus facility manager entry",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Administrative authority role",
          "enum": ["admin", "superadmin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added as admin"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": {
        "$ref": "#/entities/Ticket"
      },
      "description": "Campus maintenance complaint tickets"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Whitelisted administrator credentials"
    }
  }
}
